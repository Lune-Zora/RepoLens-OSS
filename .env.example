# RepoLens LLM / Embedding 配置模板
#
# 用法：
#   1) 复制为 .env（Windows: copy .env.example .env；Linux/macOS: cp .env.example .env）
#   2) 按本机实际情况修改端口与模型名
#   3) python scripts/llm_env.py   # 自检配置与连通性
#
# 说明：.env 已被 .gitignore 排除（.env / .env.*），真实地址与密钥绝不入库；
#       只有本模板 .env.example 会被提交，供他人/评委填入自己的配置后复现。
#
# 下方九个 LLM 字段的解析优先级（llm_env.py / run_llm_demo.py / start_web.py）：
# 真实环境变量 > .env 文件 > 脚本默认值。自检不会导出变量到父终端。
# 普通 CLI / Web 的 PowerShell 配置方法见 docs/06_运维/模型配置与启动.md。

# start_web.py 也显式读取以上九项字段；普通 uvicorn/CLI 的行为不变。
# ---- 本地 Ollama（OpenAI 兼容接口，默认端口 11434）----
# 11434/v1 是程序调用地址，不是网页；工作台用 python scripts/start_web.py 启动，打开 http://127.0.0.1:8000/。
# 早期正式Demo使用1.5B；本次通用流程默认改为本机9B标签，原实验记录不改写。
REPLENS_LLM_BASE_URL=http://127.0.0.1:11434/v1
REPLENS_LLM_MODEL=qwen35-9b-unc:latest
# 本地 Ollama 无需 key；接云端/自建网关时再填
REPLENS_LLM_API_KEY=

# 运行预算；reasoning_effort为Ollama接口的推理输出配置，不改变验证门槛。
REPLENS_LLM_TIMEOUT=180
REPLENS_LLM_MAX_TOKENS=2200
REPLENS_LLM_REASONING_EFFORT=none
REPLENS_LLM_MAX_REPAIR_ROUNDS=1

# Best-of-N 候选数
REPLENS_LLM_N_CANDIDATES=2

# 严格模式：1=未配置模型直接报错，禁止用规则引擎冒充模型结果；0=允许规则兜底
# scripts/run_llm_demo.py 始终强制严格模式，并自动保存每次模型调用记录。
# 普通 CLI / Web 不会自动加载 .env；启动它们前须在终端设置相应环境变量。
REPLENS_REQUIRE_LLM=1

# ---- 语义向量检索（可选）----
# 下方字段不会被 llm_env.py 导入进程；普通 CLI/Web 使用时须另行设置环境变量。
# 留空则混合检索自动回退 BM25；或安装本地 sentence-transformers
REPLENS_EMBED_BASE_URL=
REPLENS_EMBED_API_KEY=
REPLENS_EMBED_MODEL=BAAI/bge-small-en-v1.5
