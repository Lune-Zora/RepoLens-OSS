  "insufficient_evidence": false,
  "issue": "When a progress bar's counters are cleared and re-initialized with an infinite total, the bar must treat it as unknown, as it does at construction.",
  "patch": {
    "content": "diff --git a/tqdm/std.py b/tqdm/std.py\nindex 17eb825..1d04b90 100644\n--- a/tqdm/std.py\n+++ b/tqdm/std.py\n@@ -1378,7 +1378,8 @@ class tqdm(Comparable):\n         \"\"\"\n         self.n = 0\n         if total is not None:\n-            self.total = total\n+            # infinite total behaves the same as unknown (#651), as in __init__\n+            self.total = None if total == float(\"inf\") else total\n         if self.disable:\n             return\n         self.last_print_n = 0\n",
    "path": "patch/patch.diff",
    "sha256": "60d3981ea45901075d0774f75f35a4da41f6dd16da5b73f8b2bdcee7b4386d04"
  },
